{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoCompactEnabled": true,
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "300000",
    "ECC_HOOK_PROFILE": "standard",
    "ECC_DISABLED_HOOKS": "pre:bash:block-no-verify,pre:edit-write:suggest-compact"
  },
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease*)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f*)",
      "Bash(git checkout .)",
      "Bash(git restore .)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",
      "Read(./**/llm.yaml)",
      "Read(./**/media.yaml)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-dangerous-git.sh" },
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-commit-gate.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/auto-format.sh" }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "xagents-ecc": {
      "source": {
        "source": "settings",
        "name": "xagents-ecc",
        "owner": { "name": "X-Agents" },
        "plugins": [
          {
            "name": "ecc",
            "source": {
              "source": "github",
              "repo": "affaan-m/ECC",
              "ref": "v2.2.2",
              "sha": "c70874fae9eb0e5ad0365beb7e2955899fd1d30f"
            },
            "description": "ECC (affaan-m/ECC) ghim đúng commit đã đo — ADR gốc 0027; luật repo thắng khi trùng"
          }
        ]
      }
    }
  },
  "enabledPlugins": {
    "ecc@xagents-ecc": true,
    "ecc@ecc": false
  }
}
