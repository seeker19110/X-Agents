# Mẫu — `scripts/systemd.sh install` thay @REPO_ROOT@/@UV@ rồi ghi vào ~/.config/systemd/user/. ADR gốc 0032, 0034.
# Agent duyệt tự động `reviewer:<REVIEWER_ID>`: tiến trình riêng đọc hồ sơ gate_brief, hỏi model, ký qua
# company.gate_reviewer; không quyết được thì giữ (`reviewer.hold`) cho phiên chính. Cần hub.env bật
# COMPANY_GATE_REVIEWER=1 và khoá do người sinh một lần: `python -m company.gate_reviewer init-key --id tu-dong`.
[Unit]
Description=X-Agents reviewer — agent duyệt gate tự động (gate_reviewer run --watch)
Documentation=file://@REPO_ROOT@/docs/TRIEN-KHAI-SYSTEMD.md
Wants=xagents-gateway.service
After=network-online.target xagents-gateway.service xagents-orchestrator.service

[Service]
Type=simple
Environment=REVIEWER_ID=tu-dong
Environment=REVIEWER_WATCH=60
# stdout ra journald là pipe: không đệm thì log hiện ngay.
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-%h/.config/x-agents/hub.env
# `--db` mặc định `company.sqlite` trong thư mục này — cùng bus với orchestrator và console.
WorkingDirectory=@REPO_ROOT@/companies/software-company
ExecStart=@UV@ run --no-sync python -m company.gate_reviewer run --id ${REVIEWER_ID} --watch ${REVIEWER_WATCH} $REVIEWER_ARGS
KillSignal=SIGINT
TimeoutStopSec=60
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
