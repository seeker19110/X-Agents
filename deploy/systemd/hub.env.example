# Cấu hình hub X-Agents cho systemd user unit (ADR gốc 0032).
# `scripts/systemd.sh install` chép file này tới ~/.config/x-agents/hub.env (quyền 0600) MỘT lần — cài lại không
# đè. Sửa xong: systemctl --user restart xagents-orchestrator xagents-console
# Cú pháp: KEY=giá trị, không `export`, không thay biến kiểu shell.

# systemd user KHÔNG đọc ~/.bashrc: đây là PATH của shell lúc cài, để thấy claude, gh, uv, docker, git.
PATH=@PATH@

# --- Xưởng phần mềm (company.orchestrator) -----------------------------------------------------------------
# Cờ toàn cục, đặt TRƯỚC `run`. Làm code thật thì bắt buộc --repo; giao hàng thêm --deliver --push-remote origin.
# Ví dụ: ORCHESTRATOR_ARGS=--repo /srv/khach/web-khoa-hoc --deliver --push-remote origin
ORCHESTRATOR_ARGS=
# Giây giữa hai lượt nạp event.
ORCHESTRATOR_WATCH=10

# Model: mặc định đọc companies/software-company/llm.yaml (khuyến nghị — backend `claude-sub-mcp` của
# llm.example.yaml). Đặt COMPANY_LLM_PROVIDER ở đây thì nó GHI ĐÈ llm.yaml và bỏ `backends:` — khi đó phải đặt đủ
# cả khối dưới, thiếu model hay thiếu COMPANY_CLAUDE_MCP=1 là dự án đầu tiên kẹt ở gate escalation.
# Kiểm CLI trước khi giao việc: cd companies/software-company && uv run python -m company.probe --binary claude
# COMPANY_LLM_PROVIDER=claude-code
# COMPANY_MODEL_STRONG=claude-opus-5-5
# COMPANY_MODEL_STANDARD=claude-sonnet-5-5
# COMPANY_MODEL_LIGHT=claude-haiku-5-5
# COMPANY_CLAUDE_MCP=1

# --- Console (dashboard 127.0.0.1:8200) --------------------------------------------------------------------
# Quyền POST: --allow-decide (duyệt gate), --allow-submit (giao việc), --allow-config (sửa llm.yaml).
# Thông báo điện thoại: --notify-ntfy https://ntfy.sh/<topic-khó-đoán> hoặc --notify-telegram <chat_id>.
# KHÔNG thêm --allow-engine (orchestrator đã chạy bằng unit riêng) và KHÔNG --host 0.0.0.0 (dùng SSH tunnel).
CONSOLE_ARGS=--allow-decide

# --- Keeper (unit tùy chọn) --------------------------------------------------------------------------------
KEEPER_INTERVAL=600

# --- Agent duyệt tự động `reviewer:tu-dong` (ADR gốc 0034, unit xagents-reviewer) ----------------------------
# Tiến trình riêng đọc hồ sơ gate_brief, hỏi model tier strong, ký qua company.gate_reviewer; không quyết được thì
# giữ cho phiên chính (`gate_cli list` in "máy giữ"). Cần cờ reviewer bật và khoá do NGƯỜI sinh một lần:
#   cd companies/software-company && uv run python -m company.gate_reviewer init-key --id tu-dong
# Phạm vi: bỏ trống = chỉ approve escalation ticket/dự án; rong = mọi gate trừ spec; toan-bo = cả spec.
# COMPANY_GATE_REVIEWER=1
# COMPANY_GATE_REVIEWER_SCOPE=toan-bo
# Cờ của `gate_reviewer run` (cùng --repo với ORCHESTRATOR_ARGS để hồ sơ đọc được worktree/diff). Giây giữa hai vòng:
# REVIEWER_WATCH (mặc định 60); trần gate mỗi vòng: COMPANY_GATE_REVIEWER_MAX_PER_TICK (mặc định 5).
REVIEWER_ARGS=

# --- Bí mật: chỉ điền ở đây, trên máy chủ; file này quyền 0600 ---------------------------------------------
# Token bot Telegram, chỉ cần khi CONSOLE_ARGS có --notify-telegram.
CONSOLE_TELEGRAM_TOKEN=
